        <mxCell id="Tgm6Ucg9dFI2aTwwCTaM-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="“La IA se implementa mediante un módulo adaptativo encargado de analizar los datos registrados por el usuario para generar recomendaciones personalizadas relacionadas con entrenamiento, alimentación y progreso físico.”" vertex="1">
          <mxGeometry height="30" width="300" x="490" y="850" as="geometry" />
        </mxCell>
        <mxCell id="Tgm6Ucg9dFI2aTwwCTaM-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Se seleccionó una arquitectura por capas debido a que permite organizar el sistema de manera estructurada y modular, separando las responsabilidades entre la interfaz de usuario, la lógica del sistema, el almacenamiento de datos y el módulo adaptativo." vertex="1">
          <mxGeometry height="30" width="300" x="40" y="850" as="geometry" />
        </mxCell>
        <mxCell id="Tgm6Ucg9dFI2aTwwCTaM-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="Python fue seleccionado debido a su flexibilidad y uso frecuente en aplicaciones relacionadas con inteligencia artificial y análisis de datos." vertex="1">
          <mxGeometry height="50" width="420" x="-90" y="450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
